diff --git a/src/pagination.js b/src/pagination.js
index 4b4a5c0..5eb7f4a 100644
--- a/src/pagination.js
+++ b/src/pagination.js
@@ -8,5 +8,5 @@ export function parsePageSize(raw) {
 
