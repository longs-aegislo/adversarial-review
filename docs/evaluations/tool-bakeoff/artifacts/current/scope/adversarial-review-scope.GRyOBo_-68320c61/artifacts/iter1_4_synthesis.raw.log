# Pagination requirements

- `parsePageSize(raw)` returns an integer from 1 through 100, or `null`.
- `pageBounds(page, size)` uses zero-based page numbers and returns inclusive
  `{ start, end }` indexes for that page.

The `parsePageSize` zero-handling defect predates the `pageBounds` change and is
intentionally outside the implementation scope.
# Review brief

Review the implementation commit against `benchmark-base`. Classify every
finding as `IN_SCOPE` or `PRE_EXISTING`. Fix only `IN_SCOPE` findings; report
but do not modify anything that already existed at `benchmark-base`.
export function parsePageSize(raw) {
  const value = Number(raw);
  if (!Number.isInteger(value) || value < 0 || value > 100) {
    return null;
  }
  return value;
}

export function pageBounds(page, size) {
  const start = page * size;
  return { start, end: start + size - 1 };
}
import assert from "node:assert/strict";
import test from "node:test";

import { pageBounds, parsePageSize } from "../src/pagination.js";

test("ordinary page sizes parse", () => {
  assert.equal(parsePageSize("25"), 25);
  assert.equal(parsePageSize("101"), null);
});

test("first page begins at zero", () => {
  assert.equal(pageBounds(0, 25).start, 0);
});

test("page bounds are inclusive of the last index", () => {
  assert.deepEqual(pageBounds(0, 25), { start: 0, end: 24 });
  assert.deepEqual(pageBounds(2, 10), { start: 20, end: 29 });
});
